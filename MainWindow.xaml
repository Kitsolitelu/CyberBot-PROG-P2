<Window x:Class="ChatBotP2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot - ST10486804"
        Height="720" Width="980"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#0A0A12">

    <Window.Resources>

        <Style x:Key="SendBtn" TargetType="Button">
            <Setter Property="Background" Value="#6E40C9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="16,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#8A5CF6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClearBtn" TargetType="Button">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="14,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#30363D"/>
                                <Setter Property="Foreground" Value="#C9D1D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipBtn" TargetType="Button">
            <Setter Property="Background" Value="SkyBlue"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#6E40C9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#6E40C9"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#0D1117" Padding="0">
            <StackPanel>


                <Border Background="#0A0C16" Padding="16,12,16,8">
                    <TextBlock FontFamily="Consolas" FontSize="12"
                               Foreground="#A78BFA"
                               HorizontalAlignment="Center"
                               LineHeight="17"
                               xml:space="preserve" Width="932">    _____      _                                        _ _                                                               ____        _    
  / ____|    | |                                      (_) |             /\                                              |  _ \      | |   
 | |    _   _| |__   ___ _ __ ___  ___  ___ _   _ _ __ _| |_ _   _     /  \__      ____ _ _ __ ___ _ __   ___  ___ ___  | |_) | ___ | |_  
 | |   | | | | '_ \ / _ \ '__/ __|/ _ \/ __| | | | '__| | __| | | |   / /\ \ \ /\ / / _` | '__/ _ \ '_ \ / _ \/ __/ __| |  _ &lt; / _ \| __| 
 | |___| |_| | |_) |  __/ |  \__ \  __/ (__| |_| | |  | | |_| |_| |  / ____ \ V  V / (_| | | |  __/ | | |  __/\__ \__ \ | |_) | (_) | |_  
  \_____\__, |_.__/ \___|_|  |___/\___|\___|\__,_|_|  |_|\__|\__, | /_/    \_\_/\_/ \__,_|_|  \___|_| |_|\___||___/___/ |____/ \___/ \__| 
         __/ |                                                __/ |                                                                       
        |___/                                                |___/</TextBlock>
                </Border>

                <!-- SUBTITLE BAR -->
                <Border Padding="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0D0B1A" Offset="0"/>
                            <GradientStop Color="#161030" Offset="0.5"/>
                            <GradientStop Color="#0D0B1A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border BorderBrush="BlueViolet" BorderThickness="0,0,0,2" Padding="20,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Glowing shield icon -->
                            <Border Grid.Column="0" Height="42"
                                    CornerRadius="10" Margin="0,0,726,0" Grid.ColumnSpan="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#6E40C9" Offset="0"/>

                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="🔐🌐" FontSize="20"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontFamily="Consolas" FontSize="16" FontWeight="Bold">
                                    <TextBlock.Foreground>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#A78BFA" Offset="0"/>
                                        </LinearGradientBrush>
                                    </TextBlock.Foreground><Run Text="&#x9;"/><Run Language="en-za" Text="    "/><Run Text="CYBERSECURITY AWARENESS BOT"/></TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center" Fill="Black"/>
                                    <TextBlock
                                               FontFamily="Consolas" FontSize="11" Foreground="#64748B"><Run Text="&#x9;"/><Run Language="en-za" Text="        "/><Run Text="I am here to help you stay safe"/></TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <!-- Mood badge — glowing border -->
                            <Border Grid.Column="2" CornerRadius="20" Padding="14,6" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="Black" Offset="0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#6E40C9" Offset="0"/>
                                        <GradientStop Color="#38BDF8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Border.BorderThickness>1.5</Border.BorderThickness>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="MOOD  " FontFamily="Consolas" FontSize="10"
                                               Foreground="Gray" VerticalAlignment="Center"
                                               FontWeight="Bold"/>
                                    <TextBlock x:Name="SentimentLabel" Text="Neutral 😐"
                                               FontFamily="Consolas" FontSize="13"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center">
                                        <TextBlock.Foreground>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#A78BFA" Offset="0"/>
                                            </LinearGradientBrush>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Border>

            </StackPanel>
        </Border>

        <!-- DIVIDER — gradient glow -->
        <Border Grid.Row="1" Margin="0,0,0,407" Grid.RowSpan="2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0A0A12" Offset="0"/>
                    <GradientStop Color="#6E40C9" Offset="0.3"/>
                    <GradientStop Color="#38BDF8" Offset="0.7"/>
                    <GradientStop Color="#0A0A12" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- CHAT AREA -->
        <Border Grid.Row="2" Margin="14,10,14,8"
                BorderThickness="1" CornerRadius="8">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0A0A14" Offset="0"/>
                    <GradientStop Color="#0D0B18" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#6E40C9" Offset="0"/>
                    <GradientStop Color="#1E293B" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <ScrollViewer x:Name="ChatScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="6" Margin="0,4,0,-4">
                <StackPanel x:Name="ChatPanel" Margin="6,4"/>
            </ScrollViewer>
        </Border>

        <!-- QUICK TOPIC CHIPS -->
        <Border Grid.Row="2" Margin="14,353,14,8"
                BorderThickness="1" CornerRadius="8" Padding="10,7">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0F0B1E" Offset="0"/>
                    <GradientStop Color="#131929" Offset="0.5"/>
                    <GradientStop Color="#0F0B1E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#6E40C9" Offset="0"/>
                    <GradientStop Color="#38BDF8" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Quick topics:" FontFamily="Segoe UI" FontSize="12"
                           Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Content="🔑 Password"      Style="{StaticResource ChipBtn}" Tag="password"      Click="TopicButton_Click"/>
                <Button Content="🎣 Phishing"      Style="{StaticResource ChipBtn}" Tag="phishing"      Click="TopicButton_Click"/>
                <Button Content="🌐 Safe Browsing" Style="{StaticResource ChipBtn}" Tag="safe browsing" Click="TopicButton_Click"/>
                <Button Content="🔒 Privacy"       Style="{StaticResource ChipBtn}" Tag="privacy"       Click="TopicButton_Click"/>
                <Button Content="⚠️ Scams"          Style="{StaticResource ChipBtn}" Tag="scam"          Click="TopicButton_Click"/>
                <Button Content="🦠 Malware"       Style="{StaticResource ChipBtn}" Tag="malware"       Click="TopicButton_Click"/>
            </StackPanel>
        </Border>

        <!-- INPUT ROW -->
        <Grid Grid.Row="4" Margin="14,0,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="277*"/>
                <ColumnDefinition Width="124*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#161B22" BorderBrush="SkyBlue"
                    BorderThickness="1" CornerRadius="7" Margin="0,0,8,0" Grid.ColumnSpan="2">
                <TextBox x:Name="UserInput"
                         Background="Transparent" BorderThickness="0"
                         Foreground="#E6EDF3" CaretBrush="#C4B5FD"
                         FontFamily="Consolas" FontSize="13"
                         Padding="12,10" VerticalContentAlignment="Center"
                         KeyDown="UserInput_KeyDown"/>
            </Border>
            <Button Grid.Column="1" Content="Send ▶" Style="{StaticResource SendBtn}"
                    Height="42" Margin="248,0,63,0" Click="SendButton_Click" Grid.ColumnSpan="3"/>
            <Button Grid.Column="2" Content="Clear"  Style="{StaticResource ClearBtn}"
                    Height="42" Click="ClearButton_Click" Grid.ColumnSpan="2" Margin="75,0,0,0"/>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="5" Background="#161B22" BorderBrush="#30363D"
                BorderThickness="0,1,0,0" Padding="18,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="#4ADE80"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock x:Name="StatusBar" Text="Ready"
                               FontFamily="Consolas" FontSize="11"
                               Foreground="#4ADE80" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="ClockLabel" Grid.Column="1"
                           FontFamily="Consolas" FontSize="12" FontWeight="Bold">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#6E40C9" Offset="0"/>
                            <GradientStop Color="#38BDF8" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>
            </Grid>
        </Border>

    </Grid>
</Window>

